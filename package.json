{
  "name": "@ryangreenup/solid-daisy-components",
  "version": "1.0.0",
  "description": "Daisy UI Components Implemented in Solid-JS",
  "keywords": [
    "panda-css",
    "solid-js"
  ],
  "homepage": "https://github.com/RyanGreenup/solid-daisy-components",
  "bugs": {
    "url": "https://github.com/RyanGreenup/solid-daisy-components/issues"
  },
  "license": "ISC",
  "author": "Ryan Greenup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanGreenup/solid-daisy-components.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./components/*": {
      "import": "./components/*.tsx",
      "types": "./components/*.tsx"
    },
    "./components/*/": {
      "import": "./components/*/index.tsx",
      "types": "./components/*/index.tsx"
    },
    "./presets/*": {
      "import": "./presets/*.ts",
      "types": "./presets/*.ts"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/solid-virtual": "^3.13.12",
    "apexcharts": "^5.3.5",
    "cally": "^0.8.0",
    "chart.js": "^4.5.0",
    "cmdk-solid": "^1.1.2",
    "corvu": "^0.7.2",
    "echarts": "^6.0.0",
    "lucide-solid": "^0.500.0",
    "solid-apexcharts": "^0.6.0",
    "solid-charts": "^0.0.2",
    "solid-js": "^1.9.9",
    "solid-transition-group": "^0.3.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
